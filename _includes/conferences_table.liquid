{% assign grouped_conferences = site.data.conferences | group_by: "year" | sort: "name" | reverse %}
{% for group in grouped_conferences %}
  <h4>{{ group.name }}</h4>
  <ul>
    {% assign sorted_items = group.items | sort: "sort_date" | reverse %}
    {% for entry in sorted_items %}
      <li>{{ entry.title }} {{ entry.year }}{% if entry.speaker %} <strong>({% if entry.invited %}Invited {% endif %}{% if entry.online %}Online {% endif %}Speaker)</strong>{% elsif entry.poster %} <strong>(Poster)</strong>{% endif %}{% if entry.dates %}, {{ entry.dates }}{% endif %}{% if entry.location %}, {{ entry.location }}{% endif %}{% if entry.note %} &mdash; {{ entry.note }}{% endif %}</li>
    {% endfor %}
  </ul>
{% endfor %}
