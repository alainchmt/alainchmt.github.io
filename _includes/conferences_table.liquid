{% assign grouped_conferences = site.data.conferences | group_by: "year" | sort: "name" | reverse %}
{% for group in grouped_conferences %}
  <h5 class="card-title font-weight-bold mt-3">{{ group.name }}</h5>
  <ul class="list-group list-group-flush mb-3">
    {% assign sorted_items = group.items | sort: "sort_date" | reverse %}
    {% for entry in sorted_items %}
      <li class="list-group-item">{{ entry.title }} {{ entry.year }}{% if entry.speaker %} ({% if entry.invited %}Invited {% endif %}{% if entry.online %}Online {% endif %}Speaker){% elsif entry.poster %} (Poster){% endif %}{% if entry.dates %}, {{ entry.dates }}{% endif %}{% if entry.location %}, {{ entry.location }}{% endif %}{% if entry.note %} &mdash; {{ entry.note }}{% endif %}</li>
    {% endfor %}
  </ul>
{% endfor %}
